{
  "name": "video-copy-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "免费视频下载、转写与外部 AI 文案分析本地工作台",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dy/desktop",
    "build:content-sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-content-sidecar.ps1",
    "build:sidecar": "echo \"download sidecar 使用 apps/sidecar/dist/dy-sidecar.exe\"",
    "build:desktop": "npm run build --workspace @dy/desktop",
    "typecheck": "npm run typecheck --workspace @dy/desktop",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-win.ps1"
  },
  "devDependencies": {
    "string-width": "^8.2.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "electron": "^39.2.4"
  }
}
